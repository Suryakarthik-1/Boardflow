# Boardflow server — every value has an in-memory fallback, so the app runs
# locally with zero credentials. Copy to packages/server/.env to override.

# HTTP
PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# Durable storage (MongoDB Atlas). Empty → in-memory store.
MONGODB_URI=
MONGODB_DB=boardflow

# Pub/Sub for multi-instance fan-out. Empty → in-process.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LLM — pluggable: "deepseek" | "openai" | "mock" (default).
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings — hosted, OpenAI-compatible (DeepSeek has none).
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
